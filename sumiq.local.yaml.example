# sumiq.local.yaml — example local configuration.
#
# Never commit this file (sumiq.local.yaml is already listed in .gitignore —
# see the "add sumiq.local.yaml to .gitignore" section in README.md). Writing
# redash.api_key / api_key_command into a file tracked by git makes sumiq
# refuse to start at load time. It's not just a convention against writing it
# there — the structure actively prevents startup if you do.
#
# Usage:
#   cp sumiq.local.yaml.example sumiq.local.yaml
# then edit it to match your own environment.

version: 1

redash:
  # --- There are three ways to provide the API key. redash.api_key and
  #     redash.api_key_command are mutually exclusive (specifying both is an
  #     error) — pick one.

  # Option 1: use the SUMIQ_REDASH_API_KEY environment variable directly
  #   (nothing to write in this file).
  #   export SUMIQ_REDASH_API_KEY=xxxxxxxx
  # Simplest option; good for CI and one-off runs.

  # Option 2: reference ${env:VAR} in this file (uncomment the line below).
  #   Useful when you want a different environment variable per project, e.g.
  #   via direnv. Only the exact ${env:...} syntax is expanded — other forms
  #   like $VAR are not.
  # api_key: ${env:REDASH_API_KEY}

  # Option 3: use the stdout of an external command as the API key (uncomment
  #   the line below). Useful for pulling from a secrets manager such as the
  #   1Password CLI or the macOS Keychain. The command must print a single
  #   line to stdout within 30 seconds — a command that waits on interactive
  #   auth (e.g. a browser approval prompt) will time out and fail.
  # api_key_command: ["op", "read", "op://Private/redash/credential"]

  # If you're using option 1 (environment variable only), you can omit this
  # entire redash section.

# Data sources defined only locally (in addition to whatever the shared
# config defines). Adding one is allowed, but every run prints a warning like:
#   "Warning: my-sandbox is a local data source. Its masking policy has not
#   been reviewed."
# Shared masking rules still always apply — local config cannot loosen
# default_action below what the shared config sets.
data_sources:
  - name: my-sandbox
    id: 99

masking:
  rules:
    # Local config can only add masking rules on top of the shared ones — it
    # cannot remove or weaken them (the rules that actually apply are the
    # union across all layers, and when multiple rules match the same column
    # the strongest method wins). method: none (an explicit allow) cannot be
    # written here, since that would amount to weakening an allowlist — it can
    # only be written in the shared file (sumiq.yaml).
    - patterns: ["internal_memo"]
      method: redact
      note: "Column that only exists in my local data. Not in the team config, so added individually here."
