# sumiq.yaml — shared configuration, generated by `sumiq init`.
#
# This file is meant to be committed to git. Secrets such as API keys must not
# be written here (doing so makes sumiq refuse to start at load time — see the
# "API key" section in README.md).
#
# Edit it to match your team's Redash instance, data sources, and masking
# policy.
#
# Masking rules must be written in this file (the shared config) only, and
# reviewed like any other change. sumiq.local.yaml can only add rules on top,
# never weaken them. See docs/adr/0003-config-file-design.md for details.

version: 1

redash:
  endpoint: https://redash.example.com
  # Upper bound on waiting for a job to finish. Polling happens every poll_interval.
  timeout: 300s
  poll_interval: 1s
  # Do not put api_key here. Use sumiq.local.yaml or the SUMIQ_REDASH_API_KEY
  # environment variable instead.

# Data sources selectable via `sumiq query -d <name>`.
# The CLI only accepts names defined here — a numeric ID cannot be passed directly.
data_sources:
  - name: analytics
    id: 3
    description: "Production read replica. Contains PII, so run it as an allowlist."
    # Setting default_action: redact masks (****) any column that doesn't match
    # a rule below (allowlist mode). Only columns explicitly marked
    # method: none pass through untouched.
    default_action: redact

  - name: sandbox
    id: 7
    description: "Sandbox data source. Contains no PII."
    # Example of overriding auto_limit per data source (see the "auto_limit"
    # section in README.md).
    auto_limit: false
    # sumiq traces where each result column comes from, so that renaming a
    # column (SELECT email AS contact) doesn't drop its mask. When the query
    # can't be traced at all — it contains no SELECT (non-SQL query runners,
    # SHOW / CALL), can't be read, has an expression whose output name can't
    # be determined, or renames columns with a column alias list such as
    # WITH q(c) AS (...) — sumiq refuses to run it (alias_guard: strict, the
    # default). Set alias_guard: off for data sources where that happens by
    # nature; propagation still applies to whatever was analyzed. Only this
    # file (the shared config) may set it to off.
    # alias_guard: strict

query:
  # auto_limit is an optimization; max_rows is the actual safety net
  # (see the "auto_limit" section in README.md).
  auto_limit: true
  max_rows: 1000
  # What happens when max_rows is exceeded. `truncate` can lead to mistaking a
  # partial result for the full result set, so opt into it explicitly only
  # when you actually need it.
  on_exceed: error

masking:
  # Default handling for columns that don't match any rule below.
  # none: only matched columns are masked (denylist).
  # redact: unmatched columns are masked too (****) (allowlist).
  # Can be overridden per data source (data_sources[].default_action above).
  # Local config cannot override this to a looser value.
  default_action: none

  # Functions whose arguments must NOT propagate their mask to the output
  # column. Without this, SELECT count(email) AS n makes n inherit email's
  # mask. Empty by default — not even count is built in, so that every
  # weakening is visible in this file. Names are matched exactly and
  # case-insensitively; globs, regex:, and schema-qualified names such as
  # pg_catalog.count are rejected or simply don't match.
  #
  # Be careful with min / max / sum / avg: for a group with few rows they
  # return the original value itself (with one row, sum is the value).
  #
  # This only stops propagation. Under default_action: redact the column is
  # still masked unless you also add a method: none rule for it.
  # propagation_exempt_functions:
  #   - name: count
  #     note: "Only a row count comes out, never the value itself."

  rules:
    # Patterns are glob by default (case-insensitive; * matches any run of
    # zero or more characters, including / and newlines; ? matches any single
    # character). This is a different dialect from Go's path.Match — patterns
    # containing `[` are rejected as an error, since it's ambiguous whether it
    # should be read as a character class or a literal column-name character.
    # To match part of a column name, switch to a regex with the `regex:`
    # prefix instead. See docs/adr/0010-mask-pattern-dialect.md for details.

    - patterns: ["*email*"]
      method: partial
      keep: domain
      note: "Keep only the domain, used to distinguish traffic sources."

    - patterns: ["*phone*", "*tel*"]
      # Globs must match the whole column name, so "*tel" alone would miss a
      # column like "tel_no". Using "*tel*" catches any column name containing
      # "tel" (being a bit too broad here just means over-masking, which is
      # the safe direction to err on).
      method: redact
      note: "Phone numbers are always PII, so redact unconditionally."

    - patterns: ["user_id", "customer_id"]
      method: hash
      note: "Only needed for counting/joins within a single run. Matching hashes across separate runs is not supported by design (see the 'hash salt' section in README.md)."

    - patterns: ["regex:^(first|last)_name$"]
      method: drop
      note: "Not used in analysis, so drop the column entirely from output."

    - patterns: ["memo", "note"]
      method: redact
      note: "Free-text fields carry high risk of embedded PII, so redact unconditionally (analytics only)."
      data_sources: [analytics]

    # Example of allowlist mode (analytics' default_action: redact): explicitly
    # let through only the columns needed for aggregation. method: none can
    # only be written in the shared file. regex: is not allowed here, so list
    # each allowed column individually with a glob (see
    # docs/adr/0010-mask-pattern-dialect.md, "regex: cannot be used with
    # method: none").
    - patterns: ["id", "created_at", "status"]
      method: none
      note: "Required for aggregation and not personally identifying. Added to the allowlist."

output:
  # table / json / csv.
  #
  # Known limitation: this key is currently not consumed. `sumiq query` and
  # `sumiq data-sources list` both take --format, which carries its own default
  # of `table`, so the flag always decides the output format. The value here is
  # still validated (an invalid one fails the load), it just doesn't reach the
  # renderer yet. See docs/configuration.md#output.
  format: table
